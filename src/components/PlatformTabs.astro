---
interface Tab {
	label: string;
	id: string;
}

interface Props {
	tabs: Tab[];
	groupId?: string;
}

const { tabs, groupId = 'platform' } = Astro.props;
const uid = `pt-${groupId}-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="platform-tabs" data-platform-tabs={uid}>
	<div class="platform-tab-buttons" role="tablist">
		{
			tabs.map((tab, i) => (
				<button
					type="button"
					class:list={['platform-tab-btn', { active: i === 0 }]}
					role="tab"
					aria-selected={i === 0}
					data-tab={tab.id}
				>
					{tab.label}
				</button>
			))
		}
	</div>
	<div class="platform-tabs-panels" aria-live="polite">
		<slot />
	</div>
</div>

<script>
	import { prefersReducedMotion } from '../scripts/learn-progress';

	function initPlatformTabs(root: HTMLElement) {
		const buttons = root.querySelectorAll<HTMLButtonElement>('.platform-tab-btn');
		const panels = root.querySelectorAll<HTMLElement>('.platform-tab-panel');
		const panelsWrap = root.querySelector('.platform-tabs-panels');

		const activate = (id: string | undefined) => {
			if (!id) return;
			buttons.forEach((btn) => {
				const active = btn.dataset.tab === id;
				btn.classList.toggle('active', active);
				btn.setAttribute('aria-selected', String(active));
			});

			const showPanel = () => {
				panels.forEach((panel) => {
					panel.classList.toggle('active', panel.dataset.panel === id);
				});
				if (panelsWrap instanceof HTMLElement) {
					const activePanel = root.querySelector<HTMLElement>('.platform-tab-panel.active');
					if (activePanel) panelsWrap.style.minHeight = `${activePanel.offsetHeight}px`;
				}
			};

			if (prefersReducedMotion()) {
				showPanel();
				return;
			}

			panels.forEach((panel) => {
				if (panel.classList.contains('active')) panel.style.opacity = '0';
			});
			window.setTimeout(showPanel, 80);
		};

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => activate(btn.dataset.tab));
		});

		const initial = buttons[0]?.dataset.tab;
		if (initial) activate(initial);
	}

	document.querySelectorAll('[data-platform-tabs]').forEach((el) => {
		if (el instanceof HTMLElement) initPlatformTabs(el);
	});

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll('[data-platform-tabs]').forEach((el) => {
			if (el instanceof HTMLElement) initPlatformTabs(el);
		});
	});
</script>
