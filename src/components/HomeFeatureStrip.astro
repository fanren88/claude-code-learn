---
const features = [
	{
		title: 'Agent 循环',
		desc: '工具调用、权限确认与可审查的改动',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m16.2 16.2 2.9 2.9"/><path d="M12 18v4"/><path d="m4.9 19.1 2.9-2.9"/><path d="M2 12h4"/><path d="m4.9 4.9 2.9 2.9"/><circle cx="12" cy="12" r="3"/></svg>`,
	},
	{
		title: '项目上下文',
		desc: 'CLAUDE.md、会话与代码库理解',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>`,
	},
	{
		title: 'MCP 扩展',
		desc: '安全接入 API、数据库与外部工具',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h4"/><path d="M15 9h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-4"/><path d="M12 2v5"/></svg>`,
	},
	{
		title: 'Skills & Hooks',
		desc: '复用技能包，把重复工作流程化',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8H4l4.9 3.6-1.9 5.8L12 14.6l5 3.6-1.9-5.8L20 8.8h-6.1z"/></svg>`,
	},
];
---

<section class="home-feature-strip" aria-label="核心亮点">
	<div class="hub-shell">
	<ul class="home-feature-list">
		{
			features.map((feature) => (
				<li class="home-feature-item">
					<span class="home-feature-icon" aria-hidden="true" set:html={feature.icon} />
					<div>
						<h3>{feature.title}</h3>
						<p>{feature.desc}</p>
					</div>
				</li>
			))
		}
	</ul>
	</div>
</section>
