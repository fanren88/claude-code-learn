---
const copy = {
	kicker: 'Claude Code · 终端工作流',
	title: '学会使用 ',
	titleAccent: 'Claude Code',
	body: '面向初学者的中文学习站：从安装与登录，到理解 Agent 循环、权限与 MCP，再把 Claude Code 带进真实项目。不是完整参考手册，而是带你走通的学习路径。',
	primary: '5 分钟入门',
	primaryHref: '/start/quickstart/',
	secondary: '查看学习路径',
	secondaryHref: '#hub-learning-path',
	terminalTitle: 'claude — zsh',
	lines: [
		{ kind: 'cmd', text: 'claude' },
		{ kind: 'cmd', text: '/init' },
		{ kind: 'prompt', text: '审查这次 diff，并运行测试' },
		{ kind: 'ok', text: '改动已生成 · 等待你确认' },
	],
	steps: ['打开项目', '描述任务', '审查 diff', '运行测试'],
};
---

<section class="home-hero">
	<div class="home-hero-bg" aria-hidden="true"></div>
	<div class="home-hero-inner">
		<div class="home-hero-copy">
			<p class="home-kicker">{copy.kicker}</p>
			<h1 id="_top" class="home-hero-title">
				{copy.title}<span class="home-hero-title-accent">{copy.titleAccent}</span>
			</h1>
			<p class="home-hero-lead">{copy.body}</p>
			<div class="home-actions">
				<a class="hub-btn hub-btn-primary" href={copy.primaryHref}>{copy.primary}</a>
				<a class="hub-btn hub-btn-secondary" href={copy.secondaryHref}>{copy.secondary}</a>
			</div>
		</div>
		<div class="terminal-card" aria-label={copy.terminalTitle}>
			<div class="terminal-bar">
				<span></span>
				<span></span>
				<span></span>
				<strong>{copy.terminalTitle}</strong>
			</div>
			<div class="terminal-body">
				{
					copy.lines.map((line) => (
						<p
							class:list={['terminal-line', `terminal-line--${line.kind}`]}
							data-terminal-typed={line.kind === 'prompt' ? 'true' : undefined}
							data-full-text={line.kind === 'prompt' ? `> ${line.text}` : undefined}
						>
							{line.kind === 'ok' ? (
								line.text
							) : (
								<>
									<span>{line.kind === 'cmd' ? '$' : '>'}</span> {line.text}
								</>
							)}
						</p>
					))
				}
				<ol class="terminal-steps">
					{copy.steps.map((step) => (
						<li class="terminal-line">{step}</li>
					))}
				</ol>
				<span class="terminal-cursor" aria-hidden="true"></span>
			</div>
		</div>
	</div>
</section>
