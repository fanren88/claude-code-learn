---
interface Step {
	title: string;
	href: string;
	description: string;
}

interface Props {
	steps: Step[];
	variant?: 'timeline' | 'cards';
}

const { steps, variant = 'timeline' } = Astro.props;
const resourcesHref = '/resources/';
const continueSteps = JSON.stringify(steps.map((step) => ({ href: step.href, title: step.title })));
---

<div
	class="learning-continue"
	data-continue-learning
	data-continue-steps={continueSteps}
	data-continue-resources={resourcesHref}
	hidden
>
	<p class="learning-continue-text">
		<span data-continue-label></span>
	</p>
	<a class="learning-continue-link" data-continue-link href="#"></a>
</div>

{
	variant === 'cards' ? (
		<ol class="learning-path-cards motion-stagger-children">
			{steps.map((step, index) => (
				<li data-learning-step data-href={step.href}>
					<a class="learning-path-card shadow-card" href={step.href}>
						<div class="learning-path-card-meta">
							<span class="learning-path-card-index">
								第 {index + 1} 步
							</span>
							<span class="learning-path-card-pill">教程</span>
						</div>
						<strong>{step.title}</strong>
						<p>{step.description}</p>
					</a>
				</li>
			))}
		</ol>
	) : (
		<ol class="learning-path">
			{steps.map((step, index) => (
				<li data-learning-step data-href={step.href}>
					<div>
						<span class="learning-path-card-index">第 {index + 1} 步</span>
						<a href={step.href}>{step.title}</a>
						<p>{step.description}</p>
					</div>
				</li>
			))}
		</ol>
	)
}
