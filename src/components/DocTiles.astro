---
interface Tile {
	title: string;
	href: string;
	description: string;
	label: string;
}

interface Props {
	items: Tile[];
	stagger?: boolean;
}

const { items, stagger = false } = Astro.props;
---

<div class:list={['doc-tile-grid', { 'motion-stagger-children': stagger }]}>
	{
		items.map((item) => (
			<a class="doc-tile shadow-card" href={item.href}>
				<span class="doc-tile-badge">{item.label}</span>
				<strong>{item.title}</strong>
				<p>{item.description}</p>
				<span class="doc-tile-cta">
					开始学习 <span class="doc-tile-cta-arrow" aria-hidden="true">→</span>
				</span>
			</a>
		))
	}
</div>
