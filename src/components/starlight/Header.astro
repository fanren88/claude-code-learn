---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import { githubUrl, isTopNavActive, topNav } from '../../data/site-nav';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const pathname = Astro.url.pathname;
---

<div class="learn-header-wrap">
	<div class="header learn-header-bar hub-shell">
		<div class="title-wrapper sl-flex">
			<SiteTitle />
		</div>

		<nav class="learn-top-nav" aria-label="主导航">
			{
				topNav.map((item) => (
					<a
						href={item.href}
						class:list={['learn-top-nav-link', { 'is-active': isTopNavActive(pathname, item.href) }]}
						data-nav-href={item.href}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="sl-flex print:hidden learn-header-right">
			{shouldRenderSearch && <Search />}
			<a
				href={githubUrl}
				class="learn-github-link"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"></path>
				</svg>
			</a>
			<LanguageSelect />
			<button
				type="button"
				class="learn-nav-toggle"
				data-learn-nav-toggle
				aria-expanded="false"
				aria-controls="learn-nav-mobile"
				aria-label="打开菜单"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</div>
	</div>

	<nav id="learn-nav-mobile" class="learn-top-nav-mobile" data-learn-nav-mobile hidden aria-label="主导航">
		{
			topNav.map((item) => (
				<a
					href={item.href}
					class:list={['learn-top-nav-link', { 'is-active': isTopNavActive(pathname, item.href) }]}
					data-nav-href={item.href}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</div>

<script>
	import { initHeaderScroll } from '../../scripts/header-scroll.ts';
	import { initTopNav } from '../../scripts/top-nav.ts';

	initHeaderScroll();
	initTopNav();
</script>

<style>
	@layer starlight.core {
		.learn-header-bar.header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--sl-nav-gap);
			width: 100%;
			height: 100%;
		}

		.learn-header-bar .title-wrapper {
			flex-shrink: 0;
			min-width: 0;
		}

		.learn-header-right {
			flex-shrink: 1;
			min-width: 0;
			align-items: center;
			gap: 0.25rem;
		}

		@media (min-width: 50rem) {
			.learn-header-bar.header {
				display: grid;
				grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
				align-items: center;
				column-gap: 0.75rem;
			}

			.learn-header-bar .title-wrapper {
				grid-column: 1;
			}

			.learn-top-nav {
				grid-column: 2;
				justify-self: center;
			}

			.learn-header-right {
				grid-column: 3;
				justify-self: end;
			}
		}
	}
</style>
