---
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex learn-site-title">
	{
		config.logo && logos.dark && (
			<>
				<img
					class:list={['learn-site-logo', { 'light:sl-hidden print:hidden': !('src' in config.logo) }]}
					alt={config.logo.alt ?? 'Claude Code Learn'}
					src={logos.dark.src}
					width={logos.dark.width}
					height={logos.dark.height}
				/>
				{!('src' in config.logo) && (
					<img
						class="learn-site-logo dark:sl-hidden print:block"
						alt={config.logo.alt ?? 'Claude Code Learn'}
						src={logos.light?.src}
						width={logos.light?.width}
						height={logos.light?.height}
					/>
				)}
			</>
		)
	}
	<span class:list={{ 'sr-only': config.logo?.replacesTitle }} translate="no">
		Claude <span class="learn-site-title-accent">Learn</span>
	</span>
</a>
